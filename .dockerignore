# 构建上下文只留「运行时真正需要的东西」：根目录 *.py + requirements.txt。
# COPY 已经是显式清单，本文件的作用是让上下文体积与变化面都可预期
# （上下文里每多一个会变动的文件，镜像层缓存就越容易失效）。

# 版本控制与 CI
.git
.gitattributes
.github/

# Python 缓存与本地备份
__pycache__/
*.pyc
*.pyo
.ruff_cache/
*.syncbak.*
*.bak.*

# 运行期派生物（索引 / 指标 / 回收站）
memory_index_*.db*
memory_metrics_*.json*
.memory.lock
.trash/

# 与运行无关的目录与文档
tests/
scripts/
setup/
template/
rules/
*.md
LICENSE
ruff.toml
requirements-dev.txt
SHA256SUMS.txt

# 自身与本地编排文件
Dockerfile
.dockerignore
compose.yaml
docker-compose.yml
